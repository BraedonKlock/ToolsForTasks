<%- include('./includes/head.ejs') %>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/addEmployee.css">

</head>

<body class="body">
    <%- include('./includes/navigation.ejs') %>

    <main id="addEmployeePage-main">
        <a id="addEmployeePage-backBtn" href="<%= path %>/manageEmployees">← Back to Employees</a>

        <div id="addEmployeePage-addEmployeeContainer">
            <h1>Add Employee</h1>
            <form class="forms" action="post-addEmployee" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-control">
                    <label for="employeeid">ID:</label>
                    <input type="text" name="employeeid" >
                </div>
    
                <div class="form-control">
                    <label for="name">Name:</label>
                    <input type="text" name="name" >
                </div>
    
                <div class="form-control">
                    <label for="role">Role:</label>
                    <select name="role" id="addEmployeePage-roleSelect">
                        <option value="manager">manager</option>
                        <option value="crew">Crew</option>
                    </select>
                </div>
    
                <div class="form-control">
                    <label for="email">Email:</label>
                    <input type="text" name="email">
                </div>

                <div class="form-control">
                    <label for="password">Password:</label>
                    <input type="text" name="password">
                </div>
                <hr id="addEmployeePage-hr">
                <button type="submit" id="addEmployeePage-addBtn">Add</button>
            </form>
        </div>
    </main>
<%- include('./includes/end.ejs') %>