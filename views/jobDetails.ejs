<%- include('includes/head.ejs') %>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/jobDetails.css">

</head>

<body class="body">
    <%- include('includes/navigation.ejs') %>
    <main id="jobDetails-main">

        
        <a class="jobDetails-backBtn" href="<%= path %>">← Back to Jobs</a>
        <section class="jobDetails-container">

            <article class="jobDetails-subContainer">
                <img
                class="jobDetails-image"
                src="/photos/<%= (job.jobType || '').toLowerCase() %>.png"
                alt="<%= job.jobType %>"
                >
                <div class="jobDetails-text">
                    <h6>ID: <%= job.jobid %></h6>
                    <h6><%= job.title %></h6>
                    <h6><%= job.date %></h6>
                    <h6><%= job.address %></h6>
                    <h6><%= job.phoneNumber %></h6>
                </div>
            </article>
            <p>Notes:<br><%= job.notes %></p>
        </section>
    </main>


<%- include('includes/end.ejs') %>