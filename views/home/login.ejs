<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/login.css">


</head>

<body class="body">
    <%- include('../includes/navigation.ejs') %>

    <main id="login-main">
        <h1>Tools for Tasks</h1>
        <h6>Never forget a tool again. Save time and money</h6>
        <div id="loginForm-container">
            <form id="login-form" action="/post-login" method="POST">
                <!--CSRF TOKEN-->
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select id="loginForm-accountType" name="accountType" required >
                    <option value="" disabled selected hidden>Account Type</option>
                    <option value="owner">Owner</option>
                    <option value="employee">Employee</option>
                </select>
                <input type="text" name="email" placeholder="Email" required>
                <input type="password" name="password" placeholder="Password" required>
                <button type="submit">Log In</button>
                <a href="#">Forget Password?</a>
            </form>
            <hr>
            <div id="createAccount-container">
                <a id="createAccount-btn" href="/create-account">Create Account</a>
            </div>
        </div>
    </main>
<%- include('../includes/end.ejs') %>