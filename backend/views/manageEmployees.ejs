<%- include('./includes/head.ejs') %>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/manageEmployees.css">

</head>

<body class="body">
    <%- include('./includes/navigation.ejs') %>

    <main id="manageEmployees-main">
        <div id="manageEmployees-container">
            <h1>Managers</h1>
            <% if (managers.length > 0) { %>
                    <div id="manageEmployees-managersContainer">
                        <% for (let i = 0; i < managers.length; i ++) { %>
                            <% const manager = managers[i]; %>
                            <div class="manageEmployees-card">
                                <a href="<%= path %>/edit-employee/<%= manager.id %>">
                                    <h6><%= manager.employeeid %></h6>
                                    <div class="manageEmployeesCard-Info">
                                        <h3><%= manager.name %></h3>
                                        <hr>
                                        <h5><%= manager.role %></h5>
                                    </div>
                                </a>
                            </div>
                        <% } %>
                    </div>
            <% } else { %>
                <h1>No managers found</h1>
            <% } %>

            <h1>Crew</h1>
            <% if (crew.length > 0) { %>
                <div id="manageEmployees-crewContainer">
                    <% for (let i = 0; i < crew.length; i ++) { %>
                        <% const crewMember = crew[i]; %>
                        <div class="manageEmployees-card">
                        <a href="<%= path %>/edit-employee/<%= crewMember.id %>">
                            <h6><%= crewMember.employeeid %></h6>
                            <div class="manageEmployeesCard-Info">
                                <h3><%= crewMember.name %></h3>
                                <hr>
                                <h5><%= crewMember.role %></h5>
                            </div>
                        </a>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <h1>No Crew Found</h1>
            <% } %>
        </div>
        <a id="addEmployeeLink" href="<%= path %>/addEmployeePage"><img id="addEmployee-image" src="/photos/addEmployee.png"></a>
    </main>
<%- include('./includes/end.ejs') %>