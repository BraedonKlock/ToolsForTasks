<%- include('./includes/head.ejs') %>
<link rel="stylesheet" href="/css/main.css">
<link rel="stylesheet" href="/css/editJobPage.css">

</head>

<body class="body">
    <%- include('./includes/navigation.ejs') %>

    <main id="editJobPage-main">
        <a id="editJobPage-backBtn" href="<%= path %>/jobs">← Back to jobs</a>

        <div id="editJobPage-editJobContainer">
            <h1>Job</h1>
            <form class="forms" action="/loggedin/post-editJob/<%= job.id %>" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="form-control">
                    <label for="jobType">Job Type:</label>
                    <select name="jobType" id="editJobForm-jobType" required >
                        <option value="<%= job.jobType %>"><%= job.jobType %></option>
                        <option value="roofing">Roofing</option>
                        <option value="carpentry">Carpentry</option>
                        <option value="siding">Siding</option>
                    </select>
                </div>

                <div class="form-control">
                    <label for="jobid">ID:</label>
                    <input type="text" name="jobid" value="<%= job.jobid %>">
                </div>
    
                <div class="form-control">
                    <label for="title">Title:</label>
                    <input type="text" name="title" value="<%= job.title %>">
                </div>

                <div class="form-control">
                    <label for="date">Date:</label>
                    <input id="editJobForm-date" type="date" name="date" value="<%= job.date %>">
                </div>
    
                <div class="form-control">
                    <label for="address">Address:</label>
                    <input type="text" name="address" value="<%= job.address %>">
                </div>

                <div class="form-control">
                    <label for="phoneNumber">Phone #:</label>
                    <input type="text" name="phoneNumber" value="<%= job.phoneNumber %>">
                </div>

                <div class="form-control">
                    <label for="notes">Notes:</label>
                    <textarea id="editJobPage-notes" type="text" name="notes"><%= job.notes %></textarea>
                </div>

                <% if (allEmployees.length > 0) { %>
                    <div class="form-control">
                        <label for="addEmployee">Choose:</label>
                        <select name="addEmployee" id="addJob-employeeSelect">
                            <option value="" disabled selected hidden>Employees</option>
                                <% for (let employee of allEmployees) { %>
                                    <option
                                    value="<%= employee.email %>"
                                    data-id="<%= employee.employeeid %>"     
                                    data-role="<%= employee.role %>"
                                    data-name="<%= employee.name %>"
                                    >
                                    <%=  employee.name %> — #<%= employee.employeeid %> • <%= employee.role %>
                                    </option>
                                <% } %>
                        </select>
                    </div>
                    <button type="button" id="addJob-addEmployeeBtn">Add Employee</button>

                    <div id="addJob-employeeDisplay">
                        <% if (employees.length > 0) { %>
                            <% for (let i = 0; i < employees.length; i ++) { %>
                                <% employee = employees[i] %>
                                <div class = "employee-pill" data-empid="<%= employee.employeeid%>">
                                    <h3><%= employee.name %></h3>
                                        <div id="editJobForm-employeeData">
                                            <div class="emp-div">
                                            <p>ID:</p>
                                            <p><%= employee.employeeid %></p>
                                            </div>
                                            <div class="emp-div">
                                            <p>Role:</p>
                                            <p><%= employee.role %></p>
                                            </div>
                                        </div>
                                        <button type="button" class="addJob-removeBtn" aria-label="Remove from list">
                                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
                                            <path d="M8 12h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                            </svg>
                                        </button>
                                </div>
                                <% } %>
                            <% } %>
                    </div>
                    <!-- Hidden inputs go here -->
                    <div id="addJob-hiddenEmployees"></div>
                <% } %>
                
                <hr id="editJobPage-hr">
                <button type="submit" id="editJobPage-updateBtn">Update</button>
            </form>
        </div>
    </main>
<%- include('./includes/end.ejs') %>